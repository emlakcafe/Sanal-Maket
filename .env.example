# Yytsi/floorplan-to-3d FastAPI inference service
FLOORPLAN_ENGINE_URL=http://127.0.0.1:8000

# TKGM / MEGSIS authorized WFS integration
# Obtain these values from your authorized TKGM/MEGSIS service access.
TKGM_MEGSIS_WFS_URL=
TKGM_MEGSIS_WFS_VERSION=2.0.0
TKGM_MEGSIS_TYPENAME=
TKGM_MEGSIS_OUTPUT_FORMAT=application/json
TKGM_MEGSIS_USERNAME=
TKGM_MEGSIS_PASSWORD=
TKGM_MEGSIS_BEARER_TOKEN=

# Field names may differ by the provided MEGSIS schema.
TKGM_FIELD_CITY=il
TKGM_FIELD_DISTRICT=ilce
TKGM_FIELD_NEIGHBORHOOD=mahalle
TKGM_FIELD_BLOCK=ada
TKGM_FIELD_PARCEL=parsel

# Optional: native LibreDWG converter for .dwg uploads.
# Windows example: C:\\Tools\\LibreDWG\\bin\\dwg2dxf.exe
LIBREDWG_DWG2DXF_PATH=
